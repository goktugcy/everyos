{
  "manifestVersion": 1,
  "id": "dev.everyos.cron",
  "name": "Cron Builder",
  "version": "1.0.0",
  "description": "Build and check cron schedules: a visual builder, plain-language descriptions, next runs in any time zone, and systemd and EveryOS forms.",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "developer",
  "permissions": ["storage:app", "clipboard:write", "files:save"],
  "window": {
    "defaultWidth": 1060,
    "defaultHeight": 700,
    "minWidth": 360,
    "minHeight": 420,
    "instances": "single"
  },
  "widgets": [],
  "locales": {
    "default": "en",
    "supported": ["en", "tr", "de", "es", "fr", "it", "ja", "ko", "ru", "zh"],
    "path": "locales"
  },
  "sdk": "^1.0.0",
  "publisher": { "id": "dev.everyos", "name": "EveryOS" },
  "license": "MIT",
  "homepage": "https://github.com/goktugcy/everyos",
  "source": "https://github.com/goktugcy/everyos/tree/main/official-apps/cron"
}
