{
  "manifestVersion": 1,
  "id": "dev.everyos.markdown",
  "name": "Markdown Editor",
  "version": "1.0.0",
  "description": "Write Markdown with a live preview, highlighted code, an outline, search and replace, and HTML export.",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "productivity",
  "permissions": ["storage:app", "files:pick", "files:save", "clipboard:write"],
  "window": {
    "defaultWidth": 1100,
    "defaultHeight": 700,
    "minWidth": 360,
    "minHeight": 320,
    "instances": "single"
  },
  "widgets": [],
  "locales": {
    "default": "en",
    "supported": ["en", "tr", "de", "es", "fr", "it", "ja", "ko", "ru", "zh"],
    "path": "locales"
  },
  "sdk": "^1.0.0",
  "publisher": { "id": "dev.everyos", "name": "EveryOS" },
  "license": "MIT",
  "homepage": "https://github.com/goktugcy/everyos",
  "source": "https://github.com/goktugcy/everyos/tree/main/official-apps/markdown"
}
