{
  "manifestVersion": 1,
  "id": "dev.everyos.ports",
  "name": "Port Inspector",
  "version": "1.0.0",
  "description": "Read-only host listening sockets with protocol, bind addresses, process visibility, filters and CSV export.",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "network",
  "permissions": ["storage:app", "files:save", "system:sockets.read"],
  "window": {
    "defaultWidth": 1040,
    "defaultHeight": 720,
    "minWidth": 360,
    "minHeight": 320,
    "instances": "single"
  },
  "widgets": [],
  "locales": {
    "default": "en",
    "supported": ["en", "tr", "de", "es", "fr", "it", "ja", "ko", "ru", "zh"],
    "path": "locales"
  },
  "sdk": "^1.0.0",
  "publisher": {
    "id": "dev.everyos",
    "name": "EveryOS"
  },
  "license": "MIT",
  "homepage": "https://github.com/goktugcy/everyos",
  "source": "https://github.com/goktugcy/everyos/tree/main/official-apps/ports"
}
