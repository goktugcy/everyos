{
  "manifestVersion": 1,
  "id": "dev.everyos.whiteboard",
  "name": "Whiteboard",
  "version": "1.0.0",
  "description": "Sketch on an infinite canvas: pen, shapes, text, connecting arrows, undo and zoom. Boards are kept for you and export to PNG and SVG.",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "productivity",
  "permissions": ["storage:app", "files:pick", "files:save"],
  "window": {
    "defaultWidth": 1200,
    "defaultHeight": 800,
    "minWidth": 360,
    "minHeight": 420,
    "instances": "single"
  },
  "widgets": [],
  "locales": {
    "default": "en",
    "supported": ["en", "tr", "de", "es", "fr", "it", "ja", "ko", "ru", "zh"],
    "path": "locales"
  },
  "sdk": "^1.0.0",
  "publisher": {
    "id": "dev.everyos",
    "name": "EveryOS"
  },
  "license": "MIT",
  "homepage": "https://github.com/goktugcy/everyos",
  "source": "https://github.com/goktugcy/everyos/tree/main/official-apps/whiteboard"
}
