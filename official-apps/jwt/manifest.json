{
  "manifestVersion": 1,
  "id": "dev.everyos.jwt",
  "name": "JWT Inspector",
  "version": "1.0.0",
  "description": "Decode JSON Web Tokens, read their claims and expiry, check signatures with your own keys, and export redacted claims. Tokens never leave this device.",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "developer",
  "permissions": ["storage:app", "clipboard:write", "files:save"],
  "window": {
    "defaultWidth": 1060,
    "defaultHeight": 660,
    "minWidth": 360,
    "minHeight": 400,
    "instances": "single"
  },
  "widgets": [],
  "locales": {
    "default": "en",
    "supported": ["en", "tr", "de", "es", "fr", "it", "ja", "ko", "ru", "zh"],
    "path": "locales"
  },
  "sdk": "^1.0.0",
  "publisher": { "id": "dev.everyos", "name": "EveryOS" },
  "license": "MIT",
  "homepage": "https://github.com/goktugcy/everyos",
  "source": "https://github.com/goktugcy/everyos/tree/main/official-apps/jwt"
}
