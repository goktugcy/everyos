{
  "manifestVersion": 1,
  "id": "dev.everyos.dns",
  "name": "DNS Lookup",
  "version": "1.0.0",
  "description": "DNS records, response timing, custom resolvers, saved history and zone-file copying.",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "network",
  "permissions": ["storage:app", "network:outbound", "clipboard:write"],
  "window": {
    "defaultWidth": 1040,
    "defaultHeight": 720,
    "minWidth": 360,
    "minHeight": 320,
    "instances": "single"
  },
  "widgets": [],
  "locales": {
    "default": "en",
    "supported": ["en", "tr", "de", "es", "fr", "it", "ja", "ko", "ru", "zh"],
    "path": "locales"
  },
  "sdk": "^1.0.0",
  "publisher": {
    "id": "dev.everyos",
    "name": "EveryOS"
  },
  "license": "MIT",
  "homepage": "https://github.com/goktugcy/everyos",
  "source": "https://github.com/goktugcy/everyos/tree/main/official-apps/dns"
}
