{
  "manifestVersion": 1,
  "id": "dev.everyos.regex",
  "name": "Regex Tester",
  "version": "1.0.0",
  "description": "Test JavaScript regular expressions live: highlighted matches, groups, flags, replacements and explanations.",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "developer",
  "permissions": ["storage:app", "clipboard:write"],
  "window": {
    "defaultWidth": 1060,
    "defaultHeight": 660,
    "minWidth": 360,
    "minHeight": 400,
    "instances": "single"
  },
  "widgets": [],
  "locales": {
    "default": "en",
    "supported": ["en", "tr", "de", "es", "fr", "it", "ja", "ko", "ru", "zh"],
    "path": "locales"
  },
  "sdk": "^1.0.0",
  "publisher": { "id": "dev.everyos", "name": "EveryOS" },
  "license": "MIT",
  "homepage": "https://github.com/goktugcy/everyos",
  "source": "https://github.com/goktugcy/everyos/tree/main/official-apps/regex"
}
