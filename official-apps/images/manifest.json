{
  "manifestVersion": 1,
  "id": "dev.everyos.images",
  "name": "Image Viewer",
  "version": "1.0.0",
  "description": "View selected images with zoom, pan, rotation, metadata, original export and slideshows.",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "media",
  "permissions": ["files:pick", "files:save", "storage:app"],
  "window": {
    "defaultWidth": 1040,
    "defaultHeight": 760,
    "minWidth": 360,
    "minHeight": 320,
    "instances": "single"
  },
  "widgets": [],
  "locales": {
    "default": "en",
    "supported": ["en", "tr", "de", "es", "fr", "it", "ja", "ko", "ru", "zh"],
    "path": "locales"
  },
  "sdk": "^1.0.0",
  "publisher": {
    "id": "dev.everyos",
    "name": "EveryOS"
  },
  "license": "MIT",
  "homepage": "https://github.com/goktugcy/everyos",
  "source": "https://github.com/goktugcy/everyos/tree/main/official-apps/images"
}
