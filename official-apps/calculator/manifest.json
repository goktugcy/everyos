{
  "manifestVersion": 1,
  "id": "dev.everyos.calculator",
  "name": "Calculator",
  "version": "1.0.0",
  "description": "Standard and scientific calculator with exact decimals, history, memory and unit conversion.",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "utilities",
  "permissions": ["storage:app", "clipboard:write"],
  "window": {
    "defaultWidth": 760,
    "defaultHeight": 580,
    "minWidth": 320,
    "minHeight": 460,
    "instances": "single"
  },
  "widgets": [],
  "locales": {
    "default": "en",
    "supported": ["en", "tr", "de", "es", "fr", "it", "ja", "ko", "ru", "zh"],
    "path": "locales"
  },
  "sdk": "^1.0.0",
  "publisher": { "id": "dev.everyos", "name": "EveryOS" },
  "license": "MIT",
  "homepage": "https://github.com/goktugcy/everyos",
  "source": "https://github.com/goktugcy/everyos/tree/main/official-apps/calculator"
}
