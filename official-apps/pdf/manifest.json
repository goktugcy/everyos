{
  "manifestVersion": 1,
  "id": "dev.everyos.pdf",
  "name": "PDF Viewer",
  "version": "1.0.0",
  "description": "Read PDF files: pages and thumbnails, zoom and rotation, text search, the document outline and your own bookmarks, printing and saving a copy.",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "productivity",
  "permissions": ["storage:app", "files:pick", "files:save"],
  "window": {
    "defaultWidth": 1100,
    "defaultHeight": 780,
    "minWidth": 360,
    "minHeight": 420,
    "instances": "single"
  },
  "widgets": [],
  "locales": {
    "default": "en",
    "supported": ["en", "tr", "de", "es", "fr", "it", "ja", "ko", "ru", "zh"],
    "path": "locales"
  },
  "sdk": "^1.0.0",
  "publisher": {
    "id": "dev.everyos",
    "name": "EveryOS"
  },
  "license": "MIT",
  "homepage": "https://github.com/goktugcy/everyos",
  "source": "https://github.com/goktugcy/everyos/tree/main/official-apps/pdf"
}
