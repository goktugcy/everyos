{
  "name": "@everyos/agent",
  "version": "0.1.0",
  "private": true,
  "description": "EveryOS privileged local agent. Executes a fixed registry of validated operations requested by the API over a Unix domain socket.",
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-preserve-output src/main.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@everyos/agent-protocol": "workspace:*",
    "@everyos/catalogs": "workspace:*",
    "@everyos/logger": "workspace:*",
    "@everyos/security": "workspace:*",
    "@everyos/shared": "workspace:*",
    "@everyos/system": "workspace:*",
    "yaml": "catalog:",
    "zod": "catalog:",
    "@everyos/release": "workspace:*"
  }
}
