{
  "manifestVersion": 1,
  "id": "dev.everyos.probe",
  "name": "Probe",
  "version": "1.0.0",
  "description": "End-to-end test app: exercises the bridge and probes the sandbox.",
  "entry": "index.html",
  "icon": "icon.png",
  "category": "developer",
  "permissions": [
    "storage:app",
    "clipboard:write",
    "files:pick",
    "files:save",
    "storage:usage.read",
    "appearance:manage",
    "widgets:register"
  ],
  "window": {
    "defaultWidth": 640,
    "defaultHeight": 480,
    "minWidth": 320,
    "minHeight": 240,
    "instances": "single"
  },
  "widgets": [
    {
      "id": "status",
      "name": "Probe status",
      "description": "How many times the probe ran.",
      "entry": "widget.html",
      "sizes": ["small", "medium"],
      "defaultSize": "small",
      "placements": ["desktop", "sidebar"],
      "permissions": ["storage:app"]
    }
  ],
  "locales": {
    "default": "en",
    "supported": ["en", "tr"],
    "path": "locales"
  },
  "minEveryOS": "0.1.0",
  "sdk": "^1.0.0",
  "publisher": {
    "id": "dev.everyos",
    "name": "EveryOS"
  },
  "license": "MIT"
}
