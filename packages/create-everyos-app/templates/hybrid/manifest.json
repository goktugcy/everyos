{
  "manifestVersion": 1,
  "id": "%%APP_ID%%",
  "name": "%%APP_NAME%%",
  "version": "1.0.0",
  "description": "Your Uptime Kuma monitors on the EveryOS desktop.",
  "entry": "index.html",
  "icon": "icon.png",
  "category": "system",
  "permissions": ["integration:uptimekuma"],
  "window": {
    "defaultWidth": 720,
    "defaultHeight": 520,
    "minWidth": 360,
    "minHeight": 280,
    "instances": "single"
  },
  "widgets": [],
  "locales": {
    "default": "en",
    "supported": ["en", "tr"],
    "path": "locales"
  },
  "minEveryOS": "%%MIN_EVERYOS%%",
  "sdk": "^%%SDK_VERSION%%",
  "publisher": {
    "id": "%%PUBLISHER_ID%%",
    "name": "%%PUBLISHER_NAME%%"
  },
  "license": "MIT",
  "integration": {
    "adapter": "uptimekuma"
  }
}
